#!/bin/bash
# Enable once with: git config core.hooksPath .githooks
if git diff --quiet ORIG_HEAD HEAD -- uv.lock pyproject.toml; then
    exit 0
fi

echo "Dependencies changed. Local Nix environments sync on the next uv run --frozen --extra <profile>." >&2
echo "Rebuild cluster profiles you use on a compute node with SQLAD_EXTRA=<profile> . tools/setup-env.sh." >&2
